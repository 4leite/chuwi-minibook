[Unit]
Description=Restore GNOME orientation after leaving tablet mode
Documentation=https://gitlab.gnome.org/GNOME/mutter/-/issues/4650
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=@libexecdir@/gnome-tablet-exit-orientation
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
